import QuarticPolyExpand

open Polynomial

/-!
# Product of FOUR sparse quartics is a clean 9-term even polynomial -- K=5 analog of quarticTripleProductExpand

S2597: regenerated a THIRD time using sympy's own Add/Mul string printer for all sign/grouping
(substituting Lean text as symbol names at the very last step, after all algebra is done in plain
Aj/Bk symbols) -- avoids the hand-rolled sign-bookkeeping bug class that broke S2595 (ad-hoc
string.replace) and, per direct comparison against the PROVEN quarticTripleProductExpand.lean's own
RHS structure, apparently ALSO broke S2596's manual term_to_lean/coeff_to_lean formatter (exact root
cause not fully isolated by hand -- residual traced to a genuine Lean-side ring failure despite two
independent sympy-level correctness checks passing, so this rebuild removes ALL manual string
formatting rather than hunting further). Coefficients independently verified via direct sympy
polynomial expansion AND via full reconstruction against the true root-factored product (diff==0) --
see LEDGER S2596/S2597.

Search-before-build: grepped `quarticQuadruple`/`QuarticQuadruple` -- fresh, no existing use. -/

theorem quarticQuadrupleProductExpand (zj zk zl zm : ℂ) :
    (C (zj ^ 2 * (starRingEnd ℂ zj) ^ 2) - C (zj ^ 2 + (starRingEnd ℂ zj) ^ 2) * X ^ 2 + X ^ 4) * (C (zk ^ 2 * (starRingEnd ℂ zk) ^ 2) - C (zk ^ 2 + (starRingEnd ℂ zk) ^ 2) * X ^ 2 + X ^ 4) * (C (zl ^ 2 * (starRingEnd ℂ zl) ^ 2) - C (zl ^ 2 + (starRingEnd ℂ zl) ^ 2) * X ^ 2 + X ^ 4) * (C (zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - C (zm ^ 2 + (starRingEnd ℂ zm) ^ 2) * X ^ 2 + X ^ 4)
    =
    X ^ 16
      + C (-(zj ^ 2 + (starRingEnd ℂ zj) ^ 2) - (zk ^ 2 + (starRingEnd ℂ zk) ^ 2) - (zl ^ 2 + (starRingEnd ℂ zl) ^ 2) - (zm ^ 2 + (starRingEnd ℂ zm) ^ 2)) * X ^ 14
      + C ((zj ^ 2 * (starRingEnd ℂ zj) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 * (starRingEnd ℂ zk) ^ 2) + (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) + (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zl ^ 2 * (starRingEnd ℂ zl) ^ 2) + (zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 12
      + C (-(zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) - (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) - (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 10
      + C ((zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) + (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 8
      + C (-(zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 6
      + C ((zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) + (zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 4
      + C (-(zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 + (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 + (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 + (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2) - (zj ^ 2 + (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) * X ^ 2
      + C ((zj ^ 2 * (starRingEnd ℂ zj) ^ 2)*(zk ^ 2 * (starRingEnd ℂ zk) ^ 2)*(zl ^ 2 * (starRingEnd ℂ zl) ^ 2)*(zm ^ 2 * (starRingEnd ℂ zm) ^ 2)) := by
  simp only [map_mul, map_add, map_sub, map_pow]
  ring

#print axioms quarticQuadrupleProductExpand
