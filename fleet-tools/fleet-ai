#!/usr/bin/env python3
"""
fleet-ai — call the fleet's local LLM (Qwen3-32B on Olympus, free inference on owned GPUs).
Any fleet machine can use this instead of paid API for drafting/classification/extraction/triage.

Usage:
  fleet-ai "your prompt"                 # one-shot, prints the answer
  echo "long text" | fleet-ai --stdin "summarize this:"   # prompt + piped context
  fleet-ai --think "hard problem"        # allow Qwen3 reasoning (slower, better)
  fleet-ai --json "return JSON: ..."     # expect/return raw (no <think> strip guard)
  fleet-ai --max 800 --temp 0.3 "..."    # tune output length / temperature

Endpoint: Olympus tailnet 100.124.234.43:8000 (override with FLEET_AI_URL).
Model context is small (2048) — keep prompts tight. Exit 2 if the gateway is unreachable.
"""
import sys, os, json, urllib.request, urllib.error, re, argparse

URL = os.environ.get("FLEET_AI_URL", "http://100.124.234.43:8000/v1/chat/completions")
MODEL = os.environ.get("FLEET_AI_MODEL", "qwen3-32b-awq")

def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("prompt", nargs="*", help="the prompt (or prefix, with --stdin)")
    ap.add_argument("--stdin", action="store_true", help="append piped stdin as context")
    ap.add_argument("--think", action="store_true", help="allow reasoning (omit /no_think)")
    ap.add_argument("--json", action="store_true", help="raw output, no think-strip")
    ap.add_argument("--max", type=int, default=512, help="max output tokens")
    ap.add_argument("--temp", type=float, default=0.2, help="temperature")
    ap.add_argument("--timeout", type=int, default=120)
    a = ap.parse_args()

    prompt = " ".join(a.prompt)
    if a.stdin:
        prompt = (prompt + "\n\n" + sys.stdin.read()).strip()
    if not prompt:
        sys.stderr.write("fleet-ai: empty prompt\n"); sys.exit(1)
    if not a.think:
        prompt = "/no_think\n" + prompt   # skip Qwen3 reasoning to save the tiny context budget

    payload = json.dumps({
        "model": MODEL,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": a.max,
        "temperature": a.temp,
    }).encode()

    req = urllib.request.Request(URL, data=payload, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=a.timeout) as r:
            data = json.load(r)
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        sys.stderr.write(f"fleet-ai: gateway unreachable ({URL}): {e}\n"); sys.exit(2)

    text = data["choices"][0]["message"]["content"]
    text = re.sub(r"<think>.*?</think>", "", text, flags=re.DOTALL).strip()
    print(text)

if __name__ == "__main__":
    main()
